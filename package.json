{
  "name": "run-them-all",
  "version": "0.1.0",
  "private": true,
  "description": "Run old DOS and Windows programs, console/home computer games and whole operating systems in the browser using Boxedwine, js-dos, EmulatorJS and v86.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-runtimes.mjs",
    "fetch:force": "node scripts/fetch-runtimes.mjs --force",
    "update": "node scripts/update-runtimes.mjs",
    "update:apply": "node scripts/update-runtimes.mjs --apply",
    "serve": "node scripts/serve.mjs",
    "serve:no-coi": "node scripts/serve.mjs --no-coi",
    "start": "node scripts/fetch-runtimes.mjs && node scripts/serve.mjs",
    "test:netplay": "node tests/netplay/encryption.test.mjs && node tests/netplay/mitm.test.mjs"
  }
}
