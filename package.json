{
  "name": "run-them-all",
  "version": "0.1.0",
  "private": true,
  "description": "Run old DOS and Windows programs and console/home computer games in the browser using Boxedwine, js-dos and EmulatorJS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-runtimes.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:no-coi": "node scripts/serve.mjs --no-coi",
    "start": "node scripts/fetch-runtimes.mjs && node scripts/serve.mjs"
  }
}
